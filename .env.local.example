# Copy to .env.local and fill in. CareBridge runs with NONE of these set —
# every AI path has a deterministic fallback — but the demo is richer with them.

# ---------------------------------------------------------------------------
# Language model. Pick ONE provider; the adapter selects it from LLM_PROVIDER.
# Without a key, the assistant uses the rule-based parser in lib/ai/fallback.ts
# and summaries come from the deterministic builder in lib/health/summary.ts.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai          # openai | anthropic | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# ElevenLabs. Without a key, speech falls back to the browser's SpeechSynthesis
# (output) and SpeechRecognition (input, Chrome only).
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# One voice, everywhere. ELEVENLABS_CLINICAL_VOICE_ID is recognized but no
# longer used — kept so setting it isn't an "unknown var" surprise.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_CLINICAL_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# ---------------------------------------------------------------------------
# Fitbit, via the Google Health API (Google OAuth 2.0). Google shut down the
# legacy Fitbit Web API in September 2026; new integrations authorize through
# a Google Cloud OAuth client instead of Fitbit's own authorization server.
# Without these, the home page shows "Fitbit — Setup required" and never a
# fake Connected state. See developers.google.com/health/setup.
# ---------------------------------------------------------------------------
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
CAREBRIDGE_FITBIT_REDIRECT_URI=http://localhost:3000/api/backend/fitbit/callback
